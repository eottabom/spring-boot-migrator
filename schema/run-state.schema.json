{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "재개 기록 (.spring-boot-migrator/run-state.json)",
  "description": "러너가 쓰고 읽는다. 끝까지 마치면 지운다",
  "type": "object",
  "required": ["version", "project", "baseRevision", "startRevision", "createdFiles", "untrackedAtStop", "baseline"],
  "properties": {
    "version": { "const": 1 },
    "project": { "description": "기록을 남긴 대상 프로젝트의 절대 경로", "type": "string" },
    "baseRevision": { "description": "실행을 시작한 HEAD", "type": "string" },
    "startRevision": { "description": "누적 patch 의 기준 (시작 시점 작업 트리를 담은 커밋)", "type": "string" },
    "startBoot": { "type": ["string", "null"] },
    "createdFiles": { "description": "레시피가 만든 파일", "type": "array", "items": { "type": "string" } },
    "untrackedAtStop": { "type": "array", "items": { "type": "string" } },
    "baseline": {
      "description": "원본 빌드에서도 실패하던 태스크와 테스트",
      "type": "object",
      "required": ["failedTasks", "failedTests"],
      "properties": {
        "failedTasks": { "type": "array", "items": { "type": "string" } },
        "failedTests": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "stopped": {
      "description": "게이트에서 멈춘 stage",
      "type": ["object", "null"],
      "required": ["stage", "tag", "covers", "reason"],
      "properties": {
        "stage": { "type": "string" },
        "tag": { "type": "string", "pattern": "^[0-9]{2,}-.+$" },
        "covers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "previousTag": { "type": ["string", "null"] },
        "reason": { "enum": ["compile", "build"] },
        "treeBefore": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
